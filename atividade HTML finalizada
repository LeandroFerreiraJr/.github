<!DOCTYPE html>
<html lang='pt-BR'>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, inicial-scale=1.0">
    <meta name="description" content="área destinada ao contato do cliente">
    <title>área de contato do cliente, suporte backend</title>
</head>

<body>
    <header id="cabecalho"> 
        <h1 class="titulo">Área de Contato do Cliente</h1>
        <nav class="menu">
            <a href="#">Ajuda</a>
            <a href="#">Sair</a>
        </nav>
    </header>

    <main id="corpo-da-pagina">
    <article id="contato">
        <h2 class="subtitulo">Envie sua mensagem para a nossa equipe de suporte backend.</h2>
        <form action="/enviar" method="POST">
            <label for="nome">Nome:</label>
            <input
                type="text"
                id="nome"
                name="nome"
                required
                minlength="3"
            ><br><br>

            <label for="email">Email:</label>
            <input
                type="email"
                id="email"
                name="email"
                required
                minlength="5"
            ><br><br>

            <label for="celular">Telefone Celular:</label>
            <input
                type="text"
                id="celular"
                name="celular"
                pattern="[0-9]{11}"
                required
            ><br><br>

            <label for="msg">Mensagem:</label>
            <textarea id="msg" name="msg"></textarea><br><br>
            <input type="submit" value="Enviar">
        </form>
    </article>
    </main>

    <footer id="rodape">
        <p>2026 Suporte Tech</p>
    </footer>
</body>
</html>
